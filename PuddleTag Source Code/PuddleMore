#!/bin/sh
# PuddleMore launcher — runs the Rust desktop application.
SELF="$0"
while [ -h "$SELF" ]; do
    LINK_DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
    LINK="$(readlink "$SELF")"
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *) SELF="$LINK_DIR/$LINK" ;;
    esac
done
DIR="$(cd -P "$(dirname "$SELF")" && pwd)"

if [ -n "$PUDDLEMORE_BIN" ] && [ -x "$PUDDLEMORE_BIN" ]; then
    exec "$PUDDLEMORE_BIN" "$@"
fi

BIN="$DIR/rust/target/release/puddlemore"
if [ ! -x "$BIN" ] && command -v puddlemore >/dev/null 2>&1; then
    BIN="$(command -v puddlemore)"
fi
if [ ! -x "$BIN" ]; then
    CARGO="${CARGO:-cargo}"
    if ! command -v "$CARGO" >/dev/null 2>&1; then
        CARGO="$HOME/.cargo/bin/cargo"
    fi
    if [ ! -x "$CARGO" ]; then
        echo "PuddleMore: Rust and Cargo are required to build the application." >&2
        exit 1
    fi
    (cd "$DIR/rust" && "$CARGO" build --release) || exit 1
fi

exec "$BIN" "$@"
